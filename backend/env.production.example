# Production Environment Variables for Railway
# Copy these to your Railway environment variables

# Database configuration (Railway PostgreSQL)
PSQL_USER=postgres
PSQL_HOST=your-railway-db-host.railway.app
PSQL_DATABASE=railway
PSQL_PASSWORD=your-railway-db-password
PSQL_PORT=5432
SSL_MODE=true

# Server configuration
API_MASTER_KEY=your-secure-api-key-here-change-this
PORT=8080
NODE_ENV=production

# CORS settings
CORS_ORIGIN=https://your-vercel-app.vercel.app
