# Local Development Environment Variables for Backend
# Copy this to .env for local development

# Database configuration (local PostgreSQL)
PSQL_USER=your_local_db_username
PSQL_HOST=localhost
PSQL_DATABASE=tea_shop_db
PSQL_PASSWORD=your_local_db_password
PSQL_PORT=5432
SSL_MODE=false

# Server configuration
API_MASTER_KEY=your-secure-api-key-here-change-this
PORT=8080
NODE_ENV=development

# CORS settings
CORS_ORIGIN=http://localhost:3000

# Google OAuth (if backend needs to validate tokens)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
